{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "bottom",
  "spacing": 5,
  "height": 34,

  "modules-center": ["wlr/taskbar",],

"custom/wofi": {
  "interval": 5,
  "format": "  󰀻 ",
  "tooltip-format": "<tt>{}</tt>",
  "exec": "sh -c 'cal | sed \"s/&/\\&amp;/g; s/</\\&lt;/g; s/>/\\&gt;/g\"'",
  "on-click": "wofi --show drun --prompt Find..."
},


  "custom/firefox": {
    "interval": 5,
    "format": " 󰈹 ",
    "on-click": "firefox"},

  "custom/kitty": {
    "interval": 5,
    "format": "  ",
    "on-click": "kitty"},
},
